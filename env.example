# CallCenterAI Environment Variables
# Copy this file to .env and fill in your values
#
# KEY: [REQUIRED] must be set | [LOCAL] override for local dev | [OPTIONAL] feature-specific
#
# Generate 32-byte keys with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"

# =============================================================================
# APPLICATION
# =============================================================================
# [REQUIRED] Controls HMAC bypass, OpenAPI docs exposure, log verbosity
APP_ENVIRONMENT=development  # development | dev | local | production

# [LOCAL] When true and APP_ENVIRONMENT is development/dev/local only: allow POST
# /campaigns/{id}/start without NextGen EHR verification (ehr-test). Ignored in
# production. Use for voice/webhook testing; booking tools still need EHR config.
# ALLOW_CAMPAIGN_START_WITHOUT_EHR=true

# [LOCAL] Overridden by docker-compose; only needed for bare uvicorn
APP_PORT=8000
APP_WORKERS=4

# [OPTIONAL] Not read by the app at runtime — use this to track your tunnel/deployment URL
# for copy-pasting into the Retell dashboard (Step 5-6 in local_test_guide.md)
APP_BASE_URL=https://your-ngrok-or-tunnel-url.example.com

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# [REQUIRED] All five values required — app will not start without them
# Local dev: docker-compose sets DB_HOST=postgres automatically
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callcenterai
DB_USER=postgres
DB_PASSWORD=your-secure-password

# =============================================================================
# ENCRYPTION (PHI — Protected Health Information)
# =============================================================================
# [REQUIRED] AES-256-GCM key for all PHI stored at rest (names, summaries, phone numbers)
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PHI_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# [REQUIRED] Separate HMAC-SHA256 key for PHI hashing (phone dedup, dedup lookups)
# Must differ from PHI_ENCRYPTION_KEY (key separation principle). Generate same way.
PHI_HASH_KEY=your-32-byte-base64-encoded-hash-key

# =============================================================================
# AUTH — Admin API key + JWT
# =============================================================================
# [REQUIRED] Protects all /admin/* and /provider/* routes (X-Admin-Key header)
ADMIN_API_KEY=your-admin-api-key

# [REQUIRED] Signs and verifies staff JWTs (HS256)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256

# =============================================================================
# GOOGLE OAUTH (Staff login)
# =============================================================================
# [REQUIRED for staff login] Create credentials at console.cloud.google.com
# Authorized redirect URI must include: https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# =============================================================================
# ANTHROPIC (Claude — CSV column mapping + HEDIS call summaries)
# =============================================================================
# [OPTIONAL] Required only when SUMMARIZER_MODE=claude (default) or when CSV headers
# are non-standard (direct mapping fails and falls through to Claude).
# If not set and SUMMARIZER_MODE=claude, call summaries will fail gracefully.
ANTHROPIC_API_KEY=your-anthropic-api-key

# [OPTIONAL] Controls post-call summary generation.
# claude  (default): Claude API produces structured notes + patient_agreed decision.
# retell         : Retell's built-in call_summary stored directly (no Claude key needed).
# Switch between modes to compare summary quality on the same test calls.
SUMMARIZER_MODE=claude

# =============================================================================
# RETELL AI
# =============================================================================
# [REQUIRED] Webhook HMAC signing secret (from Retell dashboard → agent settings)
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# [REQUIRED] REST API key for initiating outbound calls
RETELL_API_KEY=your-retell-api-key

# [REQUIRED] Default outbound caller ID in E.164 format (e.g. +15551234567)
# Can be overridden per clinic via clinic_integration.retell_outbound_number
RETELL_FROM_NUMBER=+15551234567

# =============================================================================
# EHR BROWSER AUTOMATION (Browser-Use + LLM)
# =============================================================================
# [REQUIRED] LLM backend for Browser-Use EHR navigation (replaces AgentQL — HIPAA T-01 fix)
# ollama        — local Ollama (free, recommended for dev; no PHI leaves machine)
# azure_openai  — Azure OpenAI (HIPAA BAA covers text inputs; required for production)
EHR_LLM_PROVIDER=ollama

# [REQUIRED when EHR_LLM_PROVIDER=ollama]
# Install Ollama: https://ollama.com  |  Pull model: ollama pull qwen2.5:32b
OLLAMA_MODEL=qwen2.5:32b
# Local API on host: use http://localhost:11434. When the API runs inside Docker (docker-compose.dev),
# use http://host.docker.internal:11434 so the container reaches Ollama on your machine.
OLLAMA_BASE_URL=http://localhost:11434

# [OPTIONAL] Set to "false" to run Chromium in headed (visible) mode for debugging
PLAYWRIGHT_HEADLESS=true

# =============================================================================
# REDIS
# =============================================================================
# [REQUIRED] Used for EHR slot cache (90s TTL), MFA handoff, and distributed Playwright lock
# Local dev: docker-compose provides redis service, override below is automatic
# Production: use Azure Cache for Redis — rediss://:password@name.redis.cache.windows.net:6380
REDIS_URL=redis://localhost:6379

# =============================================================================
# AZURE OPENAI (EHR Browser-Use backend — production only)
# =============================================================================
# [REQUIRED when EHR_LLM_PROVIDER=azure_openai]
# HIPAA BAA covers text inputs to Azure OpenAI. Set use_vision=False (default) to
# keep image BAA coverage out of scope. See Plan 018 in PLAN.md.
# Production prerequisites (Plan 010): Zero Data Retention approval, private endpoint,
# Managed Identity, ContentLogging=false.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-07-18
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

