# CallCenterAI Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENVIRONMENT=development  # development | production
APP_PORT=8000
APP_WORKERS=4

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callcenterai
DB_USER=postgres
DB_PASSWORD=your-secure-password

# =============================================================================
# ENCRYPTION (PHI - Protected Health Information)
# =============================================================================
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PHI_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# =============================================================================
# ADMIN AUTH
# =============================================================================
# Required for all /admin/* routes (passed as X-API-Key header)
ADMIN_API_KEY=your-secure-admin-api-key

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins for the frontend dashboard
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# RETELL AI
# =============================================================================
# Webhook secret for HMAC-SHA256 signature verification (from Retell dashboard)
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret
# API key for triggering outbound calls (leave unset to run in demo/simulation mode)
# RETELL_API_KEY=your-retell-api-key
# RETELL_FROM_NUMBER=+17875550000

# =============================================================================
# REDIS (Optional - for rate limiting and distributed locks at scale)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# ANTHROPIC CLAUDE (Phase 2 - call transcript summarization)
# =============================================================================
# ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# PHASE 2 — Google OAuth (staff login)
# =============================================================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# =============================================================================
# PHASE 2 — JWT (staff session tokens)
# =============================================================================
# JWT_SECRET_KEY=your-jwt-secret
# JWT_ALGORITHM=HS256

# =============================================================================
# PHASE 2 — Azure OpenAI (inactive — do not use for new features)
# =============================================================================
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2024-07-18
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# =============================================================================
# DEMO MODE
# =============================================================================
# When RETELL_API_KEY is not set, the campaign worker uses simulate_next_call()
# to generate realistic outcomes without real API calls.
# Set DEMO_MODE=true to explicitly enable demo mode regardless of API key.
DEMO_MODE=true
