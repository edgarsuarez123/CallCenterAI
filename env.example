# CallCenterAI Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENVIRONMENT=development  # development | production
APP_PORT=8000
APP_WORKERS=4

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callcenterai
DB_USER=postgres
DB_PASSWORD=your-secure-password

# =============================================================================
# ENCRYPTION (PHI - Protected Health Information)
# =============================================================================
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PHI_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# =============================================================================
# RETELL AI
# =============================================================================
# Webhook secret for signature verification (from Retell dashboard)
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# =============================================================================
# GOOGLE CALENDAR (Optional - stored per-clinic in database)
# =============================================================================
# Service account credentials are stored in ClinicIntegration table per clinic
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# AZURE OPENAI (Optional - for AI responses)
# =============================================================================
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2024-07-18
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# =============================================================================
# REDIS (Optional - for caching)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY
# =============================================================================
# SECURITY_CORS_ORIGINS=["http://localhost:3000"]
# SECURITY_JWT_SECRET=your-jwt-secret

