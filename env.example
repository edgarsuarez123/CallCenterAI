# CallCenterAI Environment Variables
# Copy this file to .env and fill in your values
#
# KEY: [REQUIRED] must be set | [LOCAL] override for local dev | [OPTIONAL] feature-specific
#
# Generate 32-byte keys with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"

# =============================================================================
# API SECURITY
# =============================================================================
# [REQUIRED in production] Comma-separated list of allowed browser origins for
# the clinic dashboard SPA. In development, leave blank to allow localhost origins.
# Example: ALLOWED_ORIGINS=https://app.yourclinic.com,http://localhost:5173
ALLOWED_ORIGINS=

# [OPTIONAL] Per-IP HTTP rate limits (format: "N/unit" — unit: second/minute/hour/day).
RATE_LIMIT_AUTH=20/minute          # /auth/* routes + campaign start/pause/resume/cancel
RATE_LIMIT_ADMIN=20/minute         # /admin/* and /provider/* mutations
RATE_LIMIT_UPLOAD=5/minute         # POST /campaigns/upload (CSV — expensive operation)
RATE_LIMIT_RETELL_WEBHOOK=120/minute  # Retell lifecycle webhooks (higher — Retell is trusted)

# [OPTIONAL] Per-clinic Claude API calls per minute.
RATE_LIMIT_CLAUDE_PER_CLINIC=10

# =============================================================================
# APPLICATION
# =============================================================================
# [REQUIRED] Controls OpenAPI docs exposure, log verbosity
APP_ENVIRONMENT=development  # development | dev | local | production

# [LOCAL] Overridden by docker-compose; only needed for bare uvicorn
APP_PORT=8000
APP_WORKERS=4

# [OPTIONAL] Not read by the app at runtime — use this to track your tunnel/deployment URL
APP_BASE_URL=https://your-ngrok-or-tunnel-url.example.com

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# [REQUIRED] All five values required — app will not start without them
# Local dev: docker-compose sets DB_HOST=postgres automatically
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callcenterai
DB_USER=postgres
DB_PASSWORD=your-secure-password

# =============================================================================
# ENCRYPTION (PHI — Protected Health Information)
# =============================================================================
# [REQUIRED] AES-256-GCM key for all PHI stored at rest (names, summaries, phone numbers)
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PHI_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# [OPTIONAL] Separate HMAC-SHA256 key for PHI hashing (phone dedup, dedup lookups)
# Must differ from PHI_ENCRYPTION_KEY (key separation principle). Generate same way.
PHI_HASH_KEY=your-32-byte-base64-encoded-hash-key

# =============================================================================
# AUTH — Admin API key + JWT
# =============================================================================
# [REQUIRED] Protects all /admin/* routes (X-API-Key header)
ADMIN_API_KEY=your-secure-admin-api-key

# [REQUIRED] Signs and verifies staff JWTs (HS256)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins for the frontend dashboard
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# GOOGLE OAUTH (Staff login — Phase 2)
# =============================================================================
# [REQUIRED for staff login] Create credentials at console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# =============================================================================
# ANTHROPIC (Claude — CSV column mapping + HEDIS call summaries)
# =============================================================================
# [OPTIONAL] Required only when SUMMARIZER_MODE=claude (default)
ANTHROPIC_API_KEY=your-anthropic-api-key

# [OPTIONAL] Controls post-call summary generation.
# claude  (default): Claude API produces structured notes + patient_agreed decision.
# retell         : Retell's built-in call_summary stored directly (no Claude key needed).
SUMMARIZER_MODE=claude

# =============================================================================
# RETELL AI
# =============================================================================
# [REQUIRED] Webhook HMAC signing secret (from Retell dashboard → agent settings)
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# [OPTIONAL] Leave unset to run in demo/simulation mode (no real calls placed).
# Set to trigger real outbound calls via Retell API.
# RETELL_API_KEY=your-retell-api-key
# RETELL_FROM_NUMBER=+17875550000

# =============================================================================
# REDIS (Optional — for rate limiting and distributed locks at scale)
# =============================================================================
# [REQUIRED] Used for EHR slot cache (90s TTL), MFA handoff, and distributed Playwright lock
# Local dev: docker-compose provides redis service
# Production: use Azure Cache for Redis
REDIS_URL=redis://localhost:6379

# =============================================================================
# EHR BROWSER AUTOMATION (Browser-Use + LLM — Phase 2)
# =============================================================================
# [REQUIRED when EHR automation is active] LLM backend for Browser-Use EHR navigation
# ollama        — local Ollama (free, recommended for dev; no PHI leaves machine)
# azure_openai  — Azure OpenAI (HIPAA BAA covers text inputs; required for production)
EHR_LLM_PROVIDER=ollama

# [REQUIRED when EHR_LLM_PROVIDER=ollama]
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_BASE_URL=http://localhost:11434

# [OPTIONAL] Set to "false" to run Chromium in headed (visible) mode for debugging
PLAYWRIGHT_HEADLESS=true

# =============================================================================
# AZURE OPENAI (EHR Browser-Use backend — production only, Phase 2)
# =============================================================================
# [REQUIRED when EHR_LLM_PROVIDER=azure_openai]
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-07-18
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# =============================================================================
# DEMO MODE
# =============================================================================
# When RETELL_API_KEY is not set, the campaign worker uses simulate_next_call()
# to generate realistic outcomes without real API calls.
# Set DEMO_MODE=true to explicitly enable demo mode regardless of API key.
DEMO_MODE=true
