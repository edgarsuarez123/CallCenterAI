# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for all text files (recommended for cross-platform projects)
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
